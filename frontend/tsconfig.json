{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "paths": {
            "kea": ["./node_modules/kea"],
            "kea-forms": ["./node_modules/kea-forms"],
            "kea-loaders": ["./node_modules/kea-loaders"],
            "kea-router": ["./node_modules/kea-router"],
            "kea-test-utils": ["./node_modules/kea-test-utils"],
            "react": ["./node_modules/@types/react/index.d.ts"],
            "react/*": ["./node_modules/@types/react/*"],
            "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"]
        },
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "types": ["vite/client", "jest", "node"]
    },
    "include": [
        "src",
        "e2e",
        "vite.config.ts",
        "playwright.config.ts",
        "orval.config.ts",
        "../products/feature_flags/manifest.tsx",
        "../products/feature_flags/frontend"
    ]
}
