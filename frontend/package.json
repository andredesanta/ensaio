{
    "name": "ensaio-frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "generate:api": "orval --config orval.config.ts",
        "generate:kea": "kea-typegen write --config tsconfig.json --root .. --no-prettier && node scripts/normalize-kea-typegen.mjs",
        "generate": "corepack pnpm run generate:api && corepack pnpm run generate:kea && corepack pnpm run format",
        "test": "jest",
        "test:smoke": "playwright test",
        "lint": "cd .. && frontend/node_modules/.bin/oxlint frontend products/feature_flags/frontend products/feature_flags/manifest.tsx",
        "lint:fix": "cd .. && frontend/node_modules/.bin/oxlint --fix frontend products/feature_flags/frontend products/feature_flags/manifest.tsx",
        "format": "cd .. && frontend/node_modules/.bin/oxfmt --write --config frontend/.oxfmtrc.json --ignore-path frontend/.oxfmtignore frontend products/feature_flags/frontend products/feature_flags/manifest.tsx",
        "format:check": "cd .. && frontend/node_modules/.bin/oxfmt --check --config frontend/.oxfmtrc.json --ignore-path frontend/.oxfmtignore frontend products/feature_flags/frontend products/feature_flags/manifest.tsx"
    },
    "dependencies": {
        "kea": "^4.0.0-pre.6",
        "kea-forms": "^3.2.0",
        "kea-loaders": "^3.1.1",
        "kea-router": "^3.4.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@playwright/test": "1.60.0",
        "@tailwindcss/vite": "4.3.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^24.19.0",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^5.2.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "kea-test-utils": "^0.2.4",
        "kea-typegen": "3.8.3",
        "orval": "8.14.0",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "tailwindcss": "4.3.0",
        "ts-jest": "^29.4.5",
        "typescript": "6.0.3",
        "vite": "^8.1.0"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "packageManager": "pnpm@10.29.3"
}
