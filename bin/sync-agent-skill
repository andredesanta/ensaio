#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

name=""
target=""
force=0
while (($#)); do
    case "$1" in
        --name)
            name="${2:-}"
            shift 2
            ;;
        --target)
            target="${2:-}"
            shift 2
            ;;
        --force)
            force=1
            shift
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

if [[ "$name" != "managing-health-gated-rollouts" || -z "$target" ]]; then
    echo "Usage: ./bin/sync-agent-skill --name managing-health-gated-rollouts --target /path/to/client/skills [--force]" >&2
    exit 2
fi

corepack pnpm --dir services/mcp run validate >/dev/null
source_file="products/feature_flags/skills/$name/SKILL.md"
destination="$target/$name/SKILL.md"
mkdir -p "$(dirname "$destination")"

if [[ -f "$destination" ]] && ! cmp -s "$source_file" "$destination" && [[ "$force" -ne 1 ]]; then
    echo "Refusing to overwrite a different skill at $destination; pass --force to replace it." >&2
    exit 1
fi

cp "$source_file" "$destination"
echo "Synced $name to $destination"
echo "Remove with: rm -rf '$target/$name'"
