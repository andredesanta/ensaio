#!/usr/bin/env bash
# Core local checks shared with CI. Generation drift, build, and Playwright run
# separately because they need a clean Git baseline or browser tooling.
set -euo pipefail
cd "$(dirname "$0")/.."

uv run ruff check .
uv run ruff format --check .
uv run mypy
uv run tach check
# Tests use root development dependencies, while check-external validates each
# package's runtime dependencies. Keep test imports out of that package audit.
uv run tach check-external -e '**/tests/**'
./bin/check-schema
uv run pytest

(
    cd frontend
    corepack pnpm exec tsc --noEmit
    corepack pnpm run lint
    corepack pnpm run format:check
    corepack pnpm test
)

./bin/check-mcp
