#!/usr/bin/env bash
# Same checks CI runs. Use this before you consider a milestone done.
set -euo pipefail
cd "$(dirname "$0")/.."

uv run ruff check .
uv run ruff format --check .
uv run mypy
uv run tach check
# Tests use root development dependencies, while check-external validates each
# package's runtime dependencies. Keep test imports out of that package audit.
uv run tach check-external -e '**/tests/**'
./bin/check-schema
uv run pytest

(
    cd frontend
    corepack pnpm exec tsc --noEmit
    corepack pnpm exec oxlint
    corepack pnpm exec oxfmt --check .
    corepack pnpm test
)
