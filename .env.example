# Copy to .env if you need to override the defaults in ensaio_project/settings.py.
# The defaults already match docker-compose.yml, so a copy is optional for local dev.
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_DEBUG=1
POSTGRES_DB=ensaio
POSTGRES_USER=ensaio
POSTGRES_PASSWORD=ensaio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Independent stdio MCP client configuration. Replace the fake token with the
# one-time value printed by `issue_agent_token`; never commit a real value.
ENSAIO_BASE_URL=http://127.0.0.1:8000
ENSAIO_PROJECT_ID=1
ENSAIO_API_TOKEN=ens_pat_AAAAAAAAAAAAAAAAAAAAAA.BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
ENSAIO_REQUEST_TIMEOUT_MS=10000

# Optional real-model evals. Set both explicitly in your shell, not in Git.
OPENAI_API_KEY=replace-with-provider-secret
ENSAIO_EVAL_MODEL=replace-with-exact-model-id
